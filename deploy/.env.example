OSU_BOT_PORT=8000
# Optional: use a fine-grained read token for authenticated model downloads.
# HF_TOKEN=
OSU_BOT_GENERATION_PROVIDER=ollama
OSU_BOT_GENERATION_URL=https://ollama.com
OSU_BOT_GENERATION_MODEL=gpt-oss:20b
OSU_BOT_GENERATION_THINK=low
OSU_BOT_MAX_CONCURRENT_REQUESTS=4
# OSU_BOT_GENERATION_API_KEY=

# Discord closed beta. Keep the token secret and prefer a single test guild first.
# OSU_BOT_DISCORD_TOKEN=
# OSU_BOT_DISCORD_GUILD_ID=
OSU_BOT_DISCORD_EPHEMERAL=false
OSU_BOT_ANSWER_VERSION=gpt-oss-discord-v1

# Optional aggregate profile generated by `osu-bot build-style-profile`.
# OSU_BOT_STYLE_PROFILE_PATH=/app/artifacts/style/osu_chat_style.json

# Record tested image tags or digests here after the first successful run.
QDRANT_IMAGE_TAG=latest

# Required for authenticated endpoints such as the direct Ollama Cloud API.
# For Ollama Cloud, also set OSU_BOT_GENERATION_URL=https://ollama.com and
# select a model returned by https://ollama.com/api/tags.
# GPT-OSS models require OSU_BOT_GENERATION_THINK=low, medium, or high.
